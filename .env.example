# Choose source: mock | postgres
WEATHER_DATA_SOURCE=mock

# station location (used for map center + suncalc)
NEXT_PUBLIC_STATION_LAT=44.05
NEXT_PUBLIC_STATION_LON=-123.09

# Later, when you add Postgres on Render:
# WEATHER_DATA_SOURCE=postgres
# DATABASE_URL=postgres://...
# PGSSL=true

# NWS API user agent (required by api.weather.gov)
NEXT_PUBLIC_NWS_USER_AGENT=Example Personal Weather Station, you@example.com

# Optional: about page content file path (Render secret files live under /etc/secrets)
# ABOUT_CONTENT_PATH=/etc/secrets/content.md

# Required for annotations form
ANNOTATION_PIN=change-me

# Google Pollen API (server-side only)
GOOGLE_POLLEN_API_KEY=your-google-maps-platform-api-key

# Aircraft overhead (airplanes.live — server-side fetch)
AIRCRAFT_RADIUS_NM=5
AIRCRAFT_LIST_LIMIT=5
AIRCRAFT_CACHE_TTL_MS=25000
AIRCRAFT_REQUEST_TIMEOUT_MS=10000
NEXT_PUBLIC_AIRCRAFT_POLL_INTERVAL_MS=30000

# Lane Electric SmartHub (scripts/ingest-electric-usage.mjs)
SMARTHUB_USERNAME=your-email@example.com
SMARTHUB_PASSWORD=your-password
SMARTHUB_ACCT_NBR=4079101
SMARTHUB_SRV_LOC=6002
# Optional backfill start (default: yesterday only)
# Fetches every day from this date through yesterday when set.
# SMARTHUB_START_DATE=2026-06-01
